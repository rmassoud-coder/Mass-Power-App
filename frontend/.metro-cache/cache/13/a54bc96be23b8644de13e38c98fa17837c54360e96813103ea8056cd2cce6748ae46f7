// Check duplicate\n    const existing = await db.getFirstAsync(`SELECT * FROM customers WHERE mobile_number = ?`, [mobileNumber]);\n    if (existing) {\n      throw new Error('Customer with this mobile number already exists');\n    }\n    const now = new Date().toISOString();\n    const id = generateId();\n    await db.runAsync(`INSERT INTO customers (id, name, mobile_number, created_at, updated_at) VALUES (?, ?, ?, ?, ?)`, [id, name, mobileNumber, now, now]);\n    return {\n      id,\n      name,\n      mobile_number: mobileNumber,\n      created_at: now,\n      updated_at: now\n    };\n  }\n  async function updateCustomer(id, name, mobileNumber) {\n    const db = await getDb();\n    const now = new Date().toISOString();\n    await db.runAsync(`UPDATE customers SET name = ?, mobile_number = ?, updated_at = ? WHERE id = ?`, [name, mobileNumber, now, id]);\n  }\n  async function deleteCustomer(id) {\n    const db = await getDb();\n    await db.runAsync(`DELETE FROM services WHERE customer_id = ?`, [id]);\n    await db.runAsync(`DELETE FROM vehicles WHERE customer_id = ?`, [id]);\n    await db.runAsync(`DELETE FROM customers WHERE id = ?`, [id]);\n  }\n  async function searchCustomers(query) {\n    const db = await getDb();\n    const q = `%${query}%`;\n    const customers = await db.getAllAsync(`SELECT * FROM customers WHERE name LIKE ? OR mobile_number LIKE ? ORDER BY name`, [q, q]);\n    const results = [];\n    for (const customer of customers) {\n      const vehicles = await db.getAllAsync(`SELECT * FROM vehicles WHERE customer_id = ?`, [customer.id]);\n      const countRow = await db.getFirstAsync(`SELECT COUNT(*) as count FROM services WHERE customer_id = ?`, [customer.id]);\n      results.push({\n        customer,\n        vehicles,\n        total_services: countRow?.count ?? 0\n      });\n    }\n    return results;\n  }\n  async function getCustomerDetails(customerId) {\n    const db = await getDb();\n    const customer = await db.getFirstAsync(`SELECT * FRO