service_mileage: o.nextServiceMileage,\n      oil_grade: o.oilGrade || null,\n      oil_filter_changed: o.oilFilterChanged,\n      items: savedItems\n    };\n  }\n  async function updateService(id, serviceDescription, additionalInfo, cost, isPaid, dashLights, oilReminder, items, partialPaid = 0) {\n    const db = await getDb();\n    const d = dashLights || EMPTY_DASH_LIGHTS;\n    const o = oilReminder || EMPTY_OIL_REMINDER;\n    const pp = Math.max(0, Number(partialPaid) || 0);\n    await db.runAsync(`UPDATE services SET service_description = ?, additional_info = ?, cost = ?, is_paid = ?, partial_paid = ?, dash_abs = ?, dash_check_engine = ?, dash_brake = ?, dash_airbag = ?, dash_immobilizer = ?, dash_tpms = ?, dash_oil_leak = ?, current_mileage = ?, next_service_date = ?, next_service_mileage = ?, oil_grade = ?, oil_filter_changed = ? WHERE id = ?`, [serviceDescription, additionalInfo || null, cost, isPaid ? 1 : 0, pp, d.abs ? 1 : 0, d.check_engine ? 1 : 0, d.brake ? 1 : 0, d.airbag ? 1 : 0, d.immobilizer ? 1 : 0, d.tpms ? 1 : 0, d.oil_leak ? 1 : 0, o.currentMileage, o.nextServiceDate, o.nextServiceMileage, o.oilGrade || null, o.oilFilterChanged ? 1 : 0, id]);\n\n    // Replace inventory items: restore old, attach new\n    if (items !== undefined) {\n      await restoreInventoryFromServiceItems(id);\n      await attachItemsToService(id, items);\n    }\n  }\n  async function deleteService(id) {\n    const db = await getDb();\n    // Restore inventory stock before deleting\n    await restoreInventoryFromServiceItems(id);\n    await db.runAsync(`DELETE FROM services WHERE id = ?`, [id]);\n  }\n\n  // ============ Inventory Operations ============\n\n  /** Generate next inventory short code like INV-001, INV-002 */\n  async function generateInventoryItemNumber() {\n    const db = await getDb();\n    const row = await db.getFirstAsync(`SELECT MAX(CAST(SUBSTR(item_number, 5) AS INTEGER)) as max_num\n     FROM inventory\n     WHERE item_number LIKE 'INV-%'`);\n    const n