{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": null, // 🚨 THIS IS THE FIX: Completely disables iOS
      "cache": {
        "disabled": true
      },
      "env": {
        "EAS_BUILD_NPM_FORCE_INSTALL": "1"
      }
    },
    "production": {}
  },
  "submit": {
    "production": {}
  }
}
